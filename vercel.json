{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/giga/chain/admin", "destination": "/giga/chain/admin/index.html" },
    { "source": "/giga/chain/admin/", "destination": "/giga/chain/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
